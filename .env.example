# ═══════════════════════════════════════════════════════════
#  MaghzAI NotebookLM — Environment Variables
#  Copy this file to .env.local for local development.
#  On Vercel: add these via Dashboard → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── Database (REQUIRED) ────────────────────────────────────
# For Vercel deployment, use a PostgreSQL database (Neon recommended).
# Get a free database at: https://neon.tech
#
# PostgreSQL (Vercel / Neon):
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_DRIVER=postgres

# SQLite (local development only — NOT supported on Vercel):
# DATABASE_DRIVER=sqlite
# SQLITE_DB_PATH=nblm_app.db

# ─── Google Gemini AI (REQUIRED for AI features) ────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional — defaults to gemini-3.5-flash-lite)
# Recommended free-tier models:
#   gemini-3.5-flash-lite   ← fastest & cheapest (recommended)
#   gemini-3.6-flash
#   gemini-3.1-pro
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Authentication (REQUIRED) ──────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=u6g3fE3o+J2h9/0sK+mY+v+J1k4o8a3sO7i6d2g1t8e=

# ─── Email (SMTP) ───────────────────────────────────────────
# Used for verification + password-reset emails. If SMTP_* are missing, emails
# are logged to the console (dev mode only) so the flows still work locally.
# Recommended: Resend, Brevo, or any SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Bahhatha <no-reply@bahhatha.app>"

# Public origin used to build absolute links inside emails.
# Must be the real deployed domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
