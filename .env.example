# Database connection (required - already configured)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nblm_app_db

# Google Gemini API (optional - enables AI-powered features)
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional - defaults to gemini-2.5-flash-lite)
# Available free-tier models:
#   - gemini-3.1-flash-lite (recommended - fast & cheap)
#   - gemini-3.5-flash
#   - gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite
